{
  "name": "IdentifiedItem",
  "type": "object",
  "properties": {
    "scan_session_id": {
      "type": "string",
      "description": "Reference to the ScanSession"
    },
    "title": {
      "type": "string",
      "description": "Identified item name"
    },
    "brand": {
      "type": "string",
      "description": "Brand name"
    },
    "model": {
      "type": "string",
      "description": "Model number or name"
    },
    "category": {
      "type": "string",
      "description": "Main category"
    },
    "subcategory": {
      "type": "string",
      "description": "Subcategory"
    },
    "description": {
      "type": "string",
      "description": "AI-generated description"
    },
    "confidence_score": {
      "type": "number",
      "description": "Identification confidence 0-100"
    },
    "condition_guess": {
      "type": "string",
      "description": "Estimated condition"
    },
    "attributes_json": {
      "type": "string",
      "description": "JSON string of additional attributes"
    },
    "image_primary_url": {
      "type": "string",
      "description": "Primary image URL"
    },
    "normalized_search_query": {
      "type": "string",
      "description": "Optimized search query for price comparison"
    }
  },
  "required": [
    "title"
  ]
}