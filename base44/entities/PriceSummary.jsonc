{
  "name": "PriceSummary",
  "type": "object",
  "properties": {
    "identified_item_id": {
      "type": "string",
      "description": "Reference to IdentifiedItem"
    },
    "lowest_price": {
      "type": "number"
    },
    "median_price": {
      "type": "number"
    },
    "high_price": {
      "type": "number"
    },
    "average_price": {
      "type": "number"
    },
    "observed_price": {
      "type": "number",
      "description": "Price user saw in store"
    },
    "difference_from_observed": {
      "type": "number"
    },
    "deal_score": {
      "type": "number",
      "description": "0-100 deal quality score"
    },
    "recommendation_label": {
      "type": "string",
      "description": "Great deal, Fair price, Overpriced, etc."
    }
  },
  "required": [
    "identified_item_id"
  ]
}