{
  "name": "CollectionItem",
  "type": "object",
  "properties": {
    "collection_id": {
      "type": "string"
    },
    "discovery_id": {
      "type": "string"
    },
    "ar_position_x": {
      "type": "number",
      "description": "AR marker X position"
    },
    "ar_position_y": {
      "type": "number",
      "description": "AR marker Y position"
    },
    "ar_position_z": {
      "type": "number",
      "description": "AR marker Z position"
    }
  },
  "required": [
    "collection_id",
    "discovery_id"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}