{
  "name": "SellListing",
  "type": "object",
  "properties": {
    "identified_item_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "asking_price": {
      "type": "number"
    },
    "condition": {
      "type": "string",
      "enum": [
        "mint",
        "excellent",
        "good",
        "fair",
        "parts"
      ],
      "default": "good"
    },
    "category": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "platforms_json": {
      "type": "string",
      "description": "JSON array of platforms to list on"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "sold",
        "archived"
      ],
      "default": "draft"
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "seller_name": {
      "type": "string"
    },
    "contact_info": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "asking_price"
  ]
}