{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "achievement_code": {
      "type": "string"
    },
    "earned_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "achievement_code"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}