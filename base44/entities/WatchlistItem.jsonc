{
  "name": "WatchlistItem",
  "type": "object",
  "properties": {
    "identified_item_id": {
      "type": "string",
      "description": "Reference to IdentifiedItem"
    },
    "target_price": {
      "type": "number",
      "description": "Price the user wants to buy at"
    },
    "notes": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "item_title": {
      "type": "string",
      "description": "Denormalized for display"
    },
    "item_image_url": {
      "type": "string"
    },
    "current_best_price": {
      "type": "number"
    },
    "category": {
      "type": "string"
    }
  },
  "required": [
    "identified_item_id"
  ]
}