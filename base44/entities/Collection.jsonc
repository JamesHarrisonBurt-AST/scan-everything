{
  "name": "Collection",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "cover_image_url": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "amber"
    },
    "tags": {
      "type": "string",
      "description": "JSON array of tags"
    },
    "sort_preference": {
      "type": "string",
      "enum": [
        "recent",
        "oldest",
        "alpha",
        "rarity"
      ],
      "default": "recent"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}