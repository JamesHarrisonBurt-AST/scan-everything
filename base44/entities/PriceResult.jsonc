{
  "name": "PriceResult",
  "type": "object",
  "properties": {
    "identified_item_id": {
      "type": "string",
      "description": "Reference to IdentifiedItem"
    },
    "source_name": {
      "type": "string",
      "description": "Merchant or source name"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "online_retailer",
        "marketplace",
        "auction",
        "resale",
        "local",
        "unknown"
      ]
    },
    "listing_title": {
      "type": "string",
      "description": "Title of the listing"
    },
    "price_amount": {
      "type": "number",
      "description": "Price in currency"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "condition_label": {
      "type": "string",
      "description": "new, used, refurbished, etc."
    },
    "product_url": {
      "type": "string",
      "description": "Link to the listing"
    },
    "availability_label": {
      "type": "string",
      "description": "In stock, limited, etc."
    },
    "confidence_score": {
      "type": "number",
      "description": "Match confidence 0-100"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "identified_item_id",
    "source_name",
    "price_amount"
  ]
}